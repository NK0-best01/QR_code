datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DeviceCounter {
  deviceType String @id
  lastSeq    Int    @default(0)
}

model Registration {
  id         Int      @id @default(autoincrement())
  uid        String   @unique
  region     String
  province   String
  deviceType String
  seq        Int
  deviceId   String   @unique
  createdAt  DateTime @default(now())

  @@unique([deviceType, seq])
}
