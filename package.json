            "jsqr": "^1.4.0",
            "next": "16.4.2",
            "react": "19.3.0",
            "react-dom": "19.3.0",
            "react-hook-form": "^7.90.0",
            "react-simple-maps": "^5.0.5",
            "zod": "^4.6.7"
      },
      "devDependencies": {
            "@axe-core/playwright": "^4.14.0",
            "@playwright/test": "^1.64.1",
            "@tailwindcss/turbopack": "^4",
